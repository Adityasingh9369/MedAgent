# PostgreSQL + pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinicalagent

# Redis
REDIS_URL=redis://localhost:6379

# NCBI PubMed API — optional but recommended (raises rate limit to 10 req/sec)
# Get free key: https://ncbiinsights.ncbi.nlm.nih.gov/
NCBI_API_KEY=your_ncbi_key_here

# Google Gemini API — required from Phase 2 onwards
# Get free key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_key_here

# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# LangSmith — required from Phase 3
# Get at: https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=clinicalagent

# Biomedical embedding model trained specifically on PubMed
EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
EMBEDDING_DIMENSION=768

# PubMed ingestion settings
PUBMED_MAX_RESULTS=100
PUBMED_BATCH_SIZE=20

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50
